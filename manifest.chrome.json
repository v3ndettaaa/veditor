{
  "manifest_version": 3,
  "name": "veditor - PDF Annotation & Editor",
  "version": "2.7.0",
  "version_name": "2.7 Beta",
  "description": "World-class, high-performance offline PDF annotator and editor with stylus support and real PDF export.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open veditor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.mjs",
        "cmaps/*",
        "standard_fonts/*",
        "icons/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
